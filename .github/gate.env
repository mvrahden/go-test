# The settings that change the gate's verdict, read by the Makefile and by
# .github/actions/setup-go. KEY=VALUE lines only: no quotes, no spaces.
GO_VERSION=1.27.4
GO_MIN_VERSION=1.26
GORACE=atexit_sleep_ms=0
GATE_PARALLEL=16
GATE_MIN_COVERAGE=70
GATE_MIN_TOTAL_COVERAGE=70
GATE_TIMEOUT=30m
GATE_PLATFORM_TIMEOUT=30m
