=== SNAP TestBaseShapes/a_base_with_hooks p/a_test.go ===
package p

import (
	"fmt"

	"github.com/mvrahden/go-test/pkg/gotest"
)

type BaseSuite struct {
	n int
}

func (b *BaseSuite) BeforeAll(t *gotest.T)  { fmt.Println("RAN base SetupSuite") }
func (b *BaseSuite) AfterAll(t *gotest.T)   { fmt.Println("RAN base TearDownSuite") }
func (b *BaseSuite) BeforeEach(t *gotest.T) { b.n = 1; fmt.Println("RAN base SetupTest") }
func (b *BaseSuite) AfterEach(t *gotest.T)  { fmt.Println("RAN base TearDownTest") }

type ChildTestSuite struct {
	base BaseSuite
}

func (s *ChildTestSuite) BeforeAll(t *gotest.T) {
	s.base.BeforeAll(t)
}

func (s *ChildTestSuite) AfterAll(t *gotest.T) {
	s.base.AfterAll(t)
}

func (s *ChildTestSuite) BeforeEach(t *gotest.T) {
	s.base.BeforeEach(t)
}

func (s *ChildTestSuite) AfterEach(t *gotest.T) {
	s.base.AfterEach(t)
}

func (s *ChildTestSuite) TestOwn(t *gotest.T) {
	gotest.Equal(t, 1, s.base.n)
	fmt.Println("RAN child TestOwn")
}

