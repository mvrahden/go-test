package p

import (
	"fmt"

	"github.com/mvrahden/go-test/pkg/gotest"
)

type BaseTestSuiteHelpers struct{}

func (b *BaseTestSuiteHelpers) TestShared(t *gotest.T) { fmt.Println("RAN base TestShared") }

type ChildTestSuite struct{ base BaseTestSuiteHelpers }

func (s *ChildTestSuite) TestShared(t *gotest.T) {
	s.base.TestShared(t)
}

func (s *ChildTestSuite) TestOwn(t *gotest.T) { fmt.Println("RAN child TestOwn") }

