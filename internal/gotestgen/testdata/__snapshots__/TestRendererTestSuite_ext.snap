		}
		s.AfterAll(ƒteardownT)
	})
	s.BeforeAll(ƒsetupT)

	t.Run("TestOne", func(it *testing.T) {
		ttt := gotest.NewT(it)
		if ƒcfg.Timeout > 0 {
			ttt = gotest.NewTWithDeadline(it, ƒcfg.Timeout)
		}
		defer s.AfterEach(ttt)
		s.BeforeEach(ttt)
		ƒƒ_GOTEST_exec(s.TestOne, ttt)
	})
	if ƒcfg.FailFast && t.Failed() {
		return
	}

}

