func TestOrderTestSuite(t *testing.T) {
	s := &ƒƒ_GOTEST_OrderTestSuite{}
	ƒcfg := s.OrderTestSuite.SuiteConfig()
	wg := &sync.WaitGroup{}
	ƒfailed := &atomic.Bool{}

	ƒsetupT := gotest.NewT(t)
	if ƒcfg.SetupTimeout > 0 {
