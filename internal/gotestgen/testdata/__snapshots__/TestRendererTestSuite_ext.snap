	ƒcfg := gotest.DefaultSuiteConfig()
	gotest.OverlaySuiteConfig(&ƒcfg, s.ConfiguredTestSuite.SuiteConfig())

	ƒsetupT := gotest.NewT(t)
	if ƒcfg.SetupTimeout > 0 {
