@@ -5,0 +6,11 @@ func Add(a, b int) int { return a + b }
+
+// Clamp keeps n within 0 and limit.
+func Clamp(n, limit int) int {
+	if n < 0 {
+		return 0
+	}
+	if n > limit {
+		return limit
+	}
+	return n
+}
