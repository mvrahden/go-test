+// poll looks for a stop file every 25ms until quit closes.
+func (w *watcher) poll() {
+	tick := time.NewTicker(25 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case <-w.quit:
+			return
+		case <-tick.C:
+			_, _ = os.Stat(os.DevNull + ".stop")
+		}
+	}
