+// pruned copies the shown packages and rows.
+func (c *renderConfig) pruned(pkgs []*Package) []*Package {
+	var out []*Package
+	for _, p := range pkgs {
+		if !c.packageShown(p) {
+			continue
+		}
+		cp := *p
+		cp.Nodes = c.prunedNodes(p.Nodes)
+		out = append(out, &cp)
+	}
+	return out
+}
+
+func (c *renderConfig) prunedNodes(nodes []*Node) []*Node {
+	var out []*Node
+	for _, n := range c.visible(nodes) {
+		cp := *n
+		cp.Children = c.prunedNodes(n.Children)
+		out = append(out, &cp)
+	}
+	return out
+}
